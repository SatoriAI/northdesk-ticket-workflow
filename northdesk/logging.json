{
  "version": 1,
  "disable_existing_loggers": false,
  "filters": {
    "request_id": {"()": "northdesk.log.RequestIdLogFilter"}
  },
  "formatters": {
    "json": {"()": "northdesk.log.JsonFormatter"}
  },
  "handlers": {
    "stdout": {
      "class": "logging.StreamHandler",
      "stream": "ext://sys.stdout",
      "formatter": "json",
      "filters": ["request_id"]
    }
  },
  "loggers": {
    "uvicorn": {"level": "INFO"},
    "uvicorn.access": {"level": "INFO"},
    "temporalio": {"level": "INFO"}
  },
  "root": {"level": "INFO", "handlers": ["stdout"]}
}
