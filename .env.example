# Copy to .env for local runs. Docker Compose reads .env for the LLM_* values it passes to the worker.

# API
ENABLE_DOCS=true

# Temporal (API and worker)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=northdesk-tickets

# LLM (worker). fake = rule-based, no key, no network. real = needs LLM_API_KEY.
LLM_MODE=fake
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_API_KEY=

# Helpdesk client (worker)
HELPDESK_URL=http://localhost:8001
HELPDESK_TIMEOUT_SECONDS=5.0

# Fake helpdesk service
HELPDESK_DB_PATH=helpdesk.sqlite3
