# Every setting, by name. Copy to .env and fill in only what you want to change: an empty value means "use the
# default", and the defaults (in northdesk/settings.py and helpdesk/app.py) run the whole stack in fake mode.
# Docker Compose reads .env for the LLM_* and HELPDESK_*_RATE/SEED values it passes on.

# API
ENABLE_DOCS=

# Temporal (API and worker)
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_TASK_QUEUE=

# LLM (worker): LLM_MODE is fake (rule-based, no key, no network) or real (needs LLM_API_KEY)
LLM_MODE=
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Helpdesk client (worker)
HELPDESK_URL=
HELPDESK_TIMEOUT_SECONDS=

# Fake helpdesk service: fault rates are probabilities per request; the seed makes a run reproducible
HELPDESK_DB_PATH=
HELPDESK_FAILURE_RATE=
HELPDESK_LOST_RESPONSE_RATE=
HELPDESK_SEED=
